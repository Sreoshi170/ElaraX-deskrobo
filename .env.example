# Copy this file to .env. Never commit .env or paste its values into source code.

# Primary speech-to-text provider (required for fast voice commands)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=20

# Gemini reasoning and spoken responses
GEMINI_API_KEY=

# Optional provider-neutral text generation (OpenAI-compatible endpoints).
# Leave LLM_PROVIDER=gemini to use the existing Gemini integration.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Optional live market-research source provider. If unset, the adapter tries
# DuckDuckGo's public endpoint and otherwise returns a transparent no-source
# report; it never invents citations.
TAVILY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_QUALITY=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL_FAST=meta-llama/llama-3.1-8b-instruct
OPENROUTER_TIMEOUT_SECONDS=20
TAVILY_TIMEOUT_SECONDS=15
# For OpenRouter's dynamic free-model router, use openrouter/free for both.
# Optional only when you have a documented Wili-compatible search endpoint.
WILI_API_KEY=
WILI_BASE_URL=
AETHERBOT_GEMINI_MODEL=gemini-3.5-flash-lite
AETHERBOT_GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
AETHERBOT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
AETHERBOT_GEMINI_TTS_VOICE=Kore

# Google Gmail and Calendar OAuth
AETHERBOT_GOOGLE_CLIENT_FILE=secrets/google_oauth_client.json
AETHERBOT_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AETHERBOT_TOKEN_KEY_FILE=secrets/token_encryption.key

# Local application
AETHERBOT_FRONTEND_ORIGIN=http://localhost:3000
AETHERBOT_TIMEZONE=Asia/Kolkata
# SQLite account/profile database (created automatically under data/)
ELARAX_AUTH_DATABASE_FILE=data/elarax.sqlite3

# Offline multilingual STT fallback (used when Groq/Gemini STT is unavailable)
AETHERBOT_WHISPER_MODEL=base
# Leave blank for automatic language detection; the UI language selector can
# force en, hi, or bn per recording.
AETHERBOT_WHISPER_LANGUAGE=
AETHERBOT_WHISPER_ALLOW_DOWNLOAD=0
AETHERBOT_DISABLE_LOCAL_WHISPER=0
